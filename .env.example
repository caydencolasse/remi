# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone
# who downloads it. Only put non-secret values here.

# Base URL of the Remii server (Phase 4). The app never talks to OpenAI directly.
EXPO_PUBLIC_REMII_API_URL=https://api.example.invalid

# There is deliberately no OPENAI_API_KEY here. The key lives only on the
# Remii server, in that server's own environment settings.
